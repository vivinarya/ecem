from enum import Enum

class NodeState(Enum):
    VALID = ...
    STALE = ...
    INVALIDATED = ...
    SUPERSEDED = ...

class EntityType(Enum):
    Goal = ...
    Decision = ...
    Constraint = ...
    DiscardedOption = ...
    Artifact = ...

class EdgeType(Enum):
    DependsOn = ...
    DerivesFrom = ...
    Invalidates = ...
    Replaces = ...
    Supersedes = ...

class CDGNode:
    id: str
    entity_type: EntityType
    name: str
    content: str
    turn_created: int
    status: NodeState

    def __init__(
        self,
        id: str,
        entity_type: EntityType,
        name: str,
        content: str,
        turn_created: int,
        status: NodeState | None = None,
    ) -> None: ...

class CausalGraphEngine:
    def __init__(self) -> None: ...
    def insert_node(self, node: CDGNode) -> None: ...
    def add_dependency_edge(
        self, from_id: str, to_id: str, edge_type: EdgeType
    ) -> None: ...
    def mutate_and_cascade(
        self, target_id: str, new_node: CDGNode, turn_id: int = 0
    ) -> list[str]: ...
    def get_active_context_buffer(self) -> list[CDGNode]: ...

class LedgerEntry:
    index: int
    timestamp: int
    operation: str
    payload: str
    prev_hash: str
    hash: str

    def __init__(
        self,
        index: int,
        timestamp: int,
        operation: str,
        payload: str,
        prev_hash: str,
        hash: str,
    ) -> None: ...

class Ledger:
    def __init__(self) -> None: ...
    def append(self, operation: str, payload: str) -> str: ...
    def record_transition(self, state_hash: str) -> str: ...
    def latest_hash(self) -> str: ...
    def verify_integrity(self) -> bool: ...
    def get_entries(self) -> list[LedgerEntry]: ...
    def len(self) -> int: ...
    def is_empty(self) -> bool: ...
    def to_json(self) -> str: ...
